---
/**
 * Base document shell for both routes.
 *
 * Fonts are self-hosted via @fontsource — no requests to fonts.googleapis.com or
 * fonts.gstatic.com. Bricolage Grotesque comes from opsz.css rather than
 * index.css: the prototype requested `opsz,wght@12..96` and index.css ships the
 * wght axis only, while opsz.css carries both, so font-optical-sizing behaves as
 * designed on the 182px H1.
 *
 * Devanagari coverage is verified, not assumed — scripts/verify-fonts.mjs.
 *
 * SCRIPTS: the two `is:inline` blocks below are the ONLY JavaScript on /fast.
 * They are inline by design — no external file, no extra request, no framework,
 * no hydration — and they cover ThemeToggle and LiveClock, both of which have to
 * work on both routes. Everything else that moves is loaded from
 * src/pages/index.astro alone and can never reach /fast.
 */
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/rozha-one/400.css';
import '@fontsource/tiro-devanagari-hindi/400.css';

import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>

    {/* Theme, applied before first paint so there is no wrong-theme flash. Reads
        the same `rk-theme` key the prototype used. No attribute means dark, which
        is the prototype's unconditional default. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('rk-theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="rk-root">
      <slot />
    </div>

    {/* ThemeToggle + LiveClock. Inline so /fast has no dead controls and pulls no
        external script. Timings are the prototype's: the face ticks every 1000ms
        and alternates Delhi/UTC every 5200ms. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var pad = function (n) {
          return String(n).padStart(2, '0');
        };
        var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        var DAYS = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

        /* --- ThemeToggle --- */
        var label = document.querySelector('[data-theme-label]');
        var setLabel = function () {
          if (label) label.textContent = root.dataset.theme === 'light' ? 'DARK' : 'LIGHT';
        };
        setLabel();
        var toggle = document.querySelector('[data-theme-toggle]');
        if (toggle) {
          toggle.addEventListener('click', function () {
            var next = root.dataset.theme === 'light' ? 'dark' : 'light';
            root.dataset.theme = next;
            try {
              localStorage.setItem('rk-theme', next);
            } catch (e) {}
            setLabel();
          });
        }

        /* --- LiveClock --- */
        var face = document.querySelector('[data-clock]');
        var panelTime = document.querySelector('[data-clock-ist]');
        var panel = document.querySelector('[data-clock-panel]');
        var grid = document.querySelector('[data-clock-grid]');
        var caret = document.querySelector('[data-clock-caret]');
        var clockBtn = document.querySelector('[data-clock-toggle]');
        var which = 0;
        var open = false;
        var panelTimer = null;

        var istOf = function (now) {
          return new Date(now.getTime() + (330 + now.getTimezoneOffset()) * 60000);
        };

        var tick = function () {
          var now = new Date();
          var ist = istOf(now);
          if (face) {
            face.textContent =
              which % 2 === 0
                ? 'DELHI · ' + pad(ist.getHours()) + ':' + pad(ist.getMinutes()) + ':' + pad(ist.getSeconds()) + ' IST'
                : 'UTC · ' + pad(now.getUTCHours()) + ':' + pad(now.getUTCMinutes()) + ':' + pad(now.getUTCSeconds());
          }
          if (panelTime) panelTime.textContent = pad(ist.getHours()) + ':' + pad(ist.getMinutes());
        };

        var renderPanel = function () {
          if (!grid) return;
          var now = new Date();
          var ist = istOf(now);
          var rows = [
            ['DELHI NCR · IST (UTC+5:30) · WHERE I AM', pad(ist.getHours()) + ':' + pad(ist.getMinutes()) + ':' + pad(ist.getSeconds())],
            ['UTC · COORDINATED UNIVERSAL', pad(now.getUTCHours()) + ':' + pad(now.getUTCMinutes()) + ':' + pad(now.getUTCSeconds())],
            ['TODAY', DAYS[ist.getDay()] + ' ' + pad(ist.getDate()) + ' ' + MONTHS[ist.getMonth()] + ' ' + ist.getFullYear()],
          ];
          if (grid.children.length !== rows.length) {
            grid.innerHTML = rows
              .map(function () {
                return '<div class="rk-clockpanel__cell"><div class="rk-clockpanel__k"></div><div class="rk-clockpanel__v"></div></div>';
              })
              .join('');
          }
          Array.prototype.forEach.call(grid.children, function (cell, i) {
            cell.querySelector('.rk-clockpanel__k').textContent = rows[i][0];
            cell.querySelector('.rk-clockpanel__v').textContent = rows[i][1];
          });
        };

        if (clockBtn && panel) {
          clockBtn.addEventListener('click', function () {
            open = !open;
            clockBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (caret) caret.textContent = open ? '▲' : '▼';
            if (open) {
              renderPanel();
              panel.style.height = panel.firstElementChild.offsetHeight + 'px';
              panelTimer = setInterval(renderPanel, 400);
            } else {
              panel.style.height = '0px';
              if (panelTimer) clearInterval(panelTimer);
            }
          });
        }

        if (face || panelTime) {
          tick();
          setInterval(tick, 1000);
          setInterval(function () {
            which++;
            tick();
          }, 5200);
        }
      })();
    </script>
  </body>
</html>
