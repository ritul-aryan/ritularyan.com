---
/**
 * Projects.
 *
 * The feed is fetched at BUILD time and baked into static HTML — visitors make
 * no request to api.github.com. The curated list is the fallback and the build
 * never fails because GitHub is unreachable; see src/lib/github.ts.
 *
 * data-skills carries the space-separated filter keys StackFilter matches on.
 */
import { COPY } from '../data/copy';
import { fetchProjects, formatDate } from '../lib/github';

const { projects } = COPY;
const feed = await fetchProjects();
---

<section id="projects" class="rk-section" data-screen-label="Projects" data-reveal>
  <div class="rk-split" data-rk-split>
    <div class="rk-rail" data-rk-rail data-rk-pad>
      <div class="rk-rail__dev">{projects.rail.devanagari}</div>
      <div class="rk-rail__label">{projects.rail.label}</div>
      <div class="rk-rail__note">
        {projects.blurbBefore} <em>{projects.blurbTopic}</em> {projects.blurbAfter}
      </div>
      <div class="rk-rail__status">{feed.status}</div>
      <div class="rk-rail__filter" data-filter-badge></div>
    </div>

    <div class="rk-grid" data-rk-grid>
      {
        feed.projects.map((project, i) => (
          <a
            class="rk-card"
            href={project.url}
            target={project.url.startsWith('#') ? '_self' : '_blank'}
            rel="noreferrer"
            data-cursor
            data-tilt
            data-cursor-label={project.priv ? 'private · read about it' : 'open repo ↗'}
            data-skills={project.skills}
          >
            <div class="rk-card__top">
              <span>{String(i + 1).padStart(2, '0')}</span>
              <span class="rk-card__badge">{project.badge}</span>
            </div>
            <div class="rk-card__name">{project.name}</div>
            <div class="rk-card__desc">{project.description}</div>
            <div class="rk-card__tags">{project.tags}</div>
            {(project.language || project.updated) && (
              <div class="rk-card__meta">
                {[
                  project.language,
                  project.updated && `Updated ${formatDate(project.updated)}`,
                  project.stars ? `★ ${project.stars}` : '',
                ]
                  .filter(Boolean)
                  .join(' · ')}
              </div>
            )}
          </a>
        ))
      }
    </div>
  </div>
</section>
