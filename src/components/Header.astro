---
/**
 * The fixed header bar. Rendered identically on / and /fast — the prototype puts
 * this block outside both <sc-if> branches, so the only permitted difference is
 * which mode button is active.
 *
 * Approved deviation 2: the highlighted mode button reflects the actual route.
 * The prototype hardcodes FULL as active regardless of mode.
 *
 * NOTE: the nav's WORK entry points at #projects, not #work. That is the
 * prototype's deliberate choice, settled — see BUILD-RULES.md.
 *
 * The clock face, its expandable panel and the theme toggle are all driven by the
 * sanctioned inline scripts in BaseLayout, so every control here works on /fast
 * too without pulling an external script.
 */
import { COPY } from '../data/copy';

interface Props {
  /** Which route this header is on. Drives the FULL/FAST active state. */
  mode: 'full' | 'fast';
}

const { mode } = Astro.props;
const { header } = COPY;
const isFull = mode === 'full';
---

<div class="rk-bar">
  <div class="rk-bar__row">
    <a href={isFull ? '#top' : '/'} class="rk-brand" data-mark data-cursor aria-label="Ritul Aryan — home">
      <span class="rk-brand__glyph">
        <span></span><span></span><span></span><span></span>
      </span>
      <span class="rk-brand__name">{header.brand}</span>
    </a>

    <div class="rk-nav" data-rk-hide>
      {header.nav.map((link) => <a href={link.href} data-cursor>{link.label}</a>)}
    </div>

    <div class="rk-bar__spacer"></div>

    <button
      class="rk-bar__btn"
      data-rk-hide
      data-cursor
      data-clock-toggle
      title="Expand the clock"
      type="button"
      aria-expanded="false"
    >
      <span class="rk-clock__face" data-clock>{header.clockPlaceholder}</span>
      <span class="rk-clock__caret" data-clock-caret>▼</span>
    </button>

    <button
      class="rk-theme-btn"
      data-rk-btn
      data-cursor
      data-theme-toggle
      title="Switch theme"
      type="button"
    >
      <span class="rk-theme-btn__dot"></span>
      <span data-theme-label>LIGHT</span>
    </button>

    <div class="rk-modes">
      <a
        href="/"
        class:list={['rk-mode', { 'rk-mode--active': isFull }]}
        data-rk-btn
        data-cursor>{header.modeFull}</a
      >
      <a
        href="/fast"
        class:list={['rk-mode', { 'rk-mode--active': !isFull }]}
        data-rk-btn
        data-cursor>{header.modeFast}</a
      >
    </div>
  </div>

  <div class="rk-clockpanel" data-clock-panel>
    <div class="rk-clockpanel__grid" data-clock-grid></div>
  </div>
</div>
